# =============================================================
# FinancePro Chile - Variables de Entorno
# Copia este archivo como .env.local y completa todos los valores
# IMPORTANTE: Nunca commitear .env.local a git (ya está en .gitignore)
# =============================================================

# --- Supabase (Autenticación y JWT) ---
# Obtener de: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Neon PostgreSQL (Base de Datos) ---
# Obtener de: https://neon.tech → Project → Connection String
# Debe ejecutar supabase/SETUP_FINANCEPRO.sql ANTES de usar
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/financepro

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FinancePro Chile

# --- Admin Panel ---
# Clave secreta para acceder al panel admin (/admin)
# IMPORTANTE: Cambiar a algo aleatorio en producción
ADMIN_SECRET_KEY=tu-clave-admin-super-secreta
NEXT_PUBLIC_ADMIN_KEY=tu-clave-admin-super-secreta

# --- Stripe (Pagos) --- [OPCIONAL - Agregar cuando tengas cuenta]
# Obtener de: https://stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_XXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX

# --- Email (Transaccionales) --- [OPCIONAL - Para emails reales]
# Resend es el recomendado: https://resend.com
RESEND_API_KEY=re_XXXXX

# --- Gemini AI (Asistente) --- [OPCIONAL - Para chat con IA]
# Obtener de: https://aistudio.google.com → API Key
GEMINI_API_KEY=AIza...

# --- Cron Jobs (Reminders) --- [OPCIONAL - Para recordatorios automáticos]
CRON_SECRET=fp_cron_2026_tu_secreto

# --- Desarrollo ---
# No cambiar, solo para dev local
NODE_ENV=development
